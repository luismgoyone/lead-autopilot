# Copy to .env.local and fill in. Never commit real keys.
# AI: any model ID from https://ai-gateway.vercel.sh/v1/models
AI_MODEL=google/gemini-3.8-flash
# Local only; on Vercel the gateway authenticates automatically (OIDC)
AI_GATEWAY_API_KEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
RESEND_API_KEY=
OWNER_ALERT_WEBHOOK_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
