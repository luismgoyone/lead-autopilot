# Copy to .env.local and fill in. Never commit real keys.
# AI model as provider/model. Swap to anthropic/<model> + ANTHROPIC_API_KEY later.
AI_MODEL=google/gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
RESEND_API_KEY=
# Optional: sender (needs a verified domain) and a demo inbox that receives every patient email
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
OWNER_ALERT_WEBHOOK_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
